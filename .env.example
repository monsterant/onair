# 이 파일을 .env로 복사해서 쓴다. .env는 git에 올라가지 않는다.
# 아래 값은 로컬 개발용 예시다. 배포 서버에서는 반드시 다른 비밀번호를 쓴다.

# docker-compose의 PostgreSQL
POSTGRES_USER=onair
POSTGRES_PASSWORD=onair-local-only
POSTGRES_DB=onair

# docker-compose PostgreSQL이 이 PC에서 열릴 포트
DB_PORT=55432

# 백엔드
DATABASE_URL=postgres://onair:onair-local-only@localhost:55432/onair
# 이 PC에서만 받는다. 화면(vite)이 /api를 여기로 넘긴다(보안 점검 M3)
BIND_ADDR=127.0.0.1:8080
RUST_LOG=info

# OvenMediaEngine: 브라우저가 영상 통로로 붙을 주소. 필수.
#   이 PC에서만 시험: 127.0.0.1
#   같은 와이파이의 휴대폰으로 시험: 이 PC의 LAN IP (예: 192.168.0.10)
#   배포: 서버의 공인 IP
# `*`로 두면 연결이 안 된다(#10 시험).
OME_HOST_IP=127.0.0.1

# OME가 송출·시청 허락을 물을 때 쓰는 서명 키. 백엔드와 OME가 같은 값을 쓴다. 필수, 16자 이상.
# 아래 예시 값 그대로는 백엔드가 시작하지 않는다. 임의의 긴 값으로 바꾼다.
#   예) PowerShell: [guid]::NewGuid().ToString('N')
OME_ADMISSION_SECRET=change-me

# 심사용 테스트 계정 로그인(/auth/demo/1, /auth/demo/2). true일 때만 열린다(#4).
DEMO_LOGIN=true

# OME 관리 API(#3): 백엔드가 방송 종료 때 스트림을 끊는 데 쓴다. 16자 이상 임의 값. OME와 백엔드가 같은 값을 쓴다.
OME_API_TOKEN=change-me
OME_API_URL=http://localhost:8081

# 도네이션(#41): 토스페이먼츠 테스트 모드 키. 비우면 도네이션이 꺼진다(실제 돈은 나가지 않는다).
# - 결제위젯용 키(test_gck_..., test_gsk_...)를 쓴다. 토스 공식 예제 저장소(github.com/tosspayments/tosspayments-sample)의
#   결제위젯 문서용 테스트 키나, 토스페이먼츠 개발자센터에서 받은 내 테스트 키를 넣는다.
# - 비밀 키(TOSS_SECRET_KEY)는 서버에만 둔다. 클라이언트 키는 화면에 그대로 보내도 되는 값이다.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 녹화 파일 폴더(#47). docker compose의 OME가 ./recordings에 쓴다. 백엔드는 backend/에서 실행하므로 ../recordings
RECORDINGS_DIR=../recordings
