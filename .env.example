# 이 파일을 .env로 복사해서 쓴다. .env는 git에 올라가지 않는다.
# 아래 값은 로컬 개발용 예시다. 배포 서버에서는 반드시 다른 비밀번호를 쓴다.

# docker-compose의 PostgreSQL
POSTGRES_USER=onair
POSTGRES_PASSWORD=onair-local-only
POSTGRES_DB=onair

# docker-compose PostgreSQL이 이 PC에서 열릴 포트
DB_PORT=55432

# 백엔드
DATABASE_URL=postgres://onair:onair-local-only@localhost:55432/onair
BIND_ADDR=0.0.0.0:8080
RUST_LOG=info

# OvenMediaEngine: 다른 기기가 붙을 때 쓸 이 PC의 IP (예: 192.168.0.10). 비우면 기본값.
OME_HOST_IP=
