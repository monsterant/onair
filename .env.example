# 이 파일을 .env로 복사해서 쓴다. .env는 git에 올라가지 않는다.
# 아래 값은 로컬 개발용 예시다. 배포 서버에서는 반드시 다른 비밀번호를 쓴다.

# docker-compose의 PostgreSQL
POSTGRES_USER=onair
POSTGRES_PASSWORD=onair-local-only
POSTGRES_DB=onair

# docker-compose PostgreSQL이 이 PC에서 열릴 포트
DB_PORT=55432

# 백엔드
DATABASE_URL=postgres://onair:onair-local-only@localhost:55432/onair
BIND_ADDR=0.0.0.0:8080
RUST_LOG=info

# OvenMediaEngine: 브라우저가 영상 통로로 붙을 주소. 필수.
#   이 PC에서만 시험: 127.0.0.1
#   같은 와이파이의 휴대폰으로 시험: 이 PC의 LAN IP (예: 192.168.0.10)
#   배포: 서버의 공인 IP
# `*`로 두면 연결이 안 된다(#10 시험).
OME_HOST_IP=127.0.0.1

# OME가 송출·시청 허락을 물을 때 쓰는 서명 키. 백엔드와 OME가 같은 값을 쓴다. 필수, 16자 이상.
# 아래 예시 값 그대로는 백엔드가 시작하지 않는다. 임의의 긴 값으로 바꾼다.
#   예) PowerShell: [guid]::NewGuid().ToString('N')
OME_ADMISSION_SECRET=change-me
