<?xml version="1.0" encoding="UTF-8"?>
<!--
  OvenMediaEngine 로그 설정 (#28 V11). 이미지 v0.21.0 기본 origin_conf/Logger.xml에 아래 두 가지만 바꿨다.
  1. 송출 주소에는 송출 키가 쿼리(?key=...)로 들어간다. WHIP(송출 요청 접수)와 AccessController(송출 허락 확인)는
     info 수준에서 이 주소를 그대로 찍는다. 서버 로그를 남에게 보여 주면 키가 새므로 두 태그는 warn 이상만 남긴다.
     송출 허락·거절 기록은 백엔드 로그(키는 가림)에 남는다.
  2. 컨테이너 안 로그 파일(/var/log/ovenmediaengine)을 끈다. 같은 내용이 docker 로그(stdout)에도 남고,
     파일은 정리되지 않고 계속 커진다.
  태그 이름은 정규식이고 위에서부터 처음 맞는 줄이 쓰인다. 그래서 ".*"는 맨 아래에 둔다.
-->
<Logger version="2">
	<Path>/var/log/ovenmediaengine</Path>
	<File enabled="false"/>

	<Tag name="WHIP" level="warn" />
	<Tag name="AccessController" level="warn" />
	<!-- 송출이 거절되면(틀린 키, 종료된 방송) 키가 든 주소를 WebRTC Provider는 warn, HTTP.Server는 error로 찍는다(#28 리뷰).
	     WebRTC Provider는 error 이상만, HTTP.Server는 critical만 남긴다. 거절 기록은 백엔드 로그(키는 가림)와 Caddy 로그에 남는다. -->
	<Tag name="WebRTC Provider" level="error" />
	<Tag name="HTTP.Server" level="critical" />

	<!-- 아래는 기본 설정 그대로 -->
	<Tag name="SRT" level="critical" />
	<Tag name=".*\.Stat" level="warn" />
	<Tag name=".*" level="info" />
</Logger>
