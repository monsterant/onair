# 배포용 Caddy 설정 (#5). 도메인은 .env의 DOMAIN에서 받는다.
# Caddy가 Let's Encrypt에서 HTTPS 인증서를 자동으로 받고 갱신한다(80, 443 포트 필요).
{$DOMAIN} {
	encode gzip

	# 보안 헤더(#21 S3)
	# - HSTS: 한 번 들어온 브라우저는 다음부터 http로 시도하지 않고 바로 https로 온다.
	# - nosniff: 브라우저가 파일 종류를 멋대로 추측하지 않게 한다.
	# - frame-ancestors 'none': 다른 사이트가 우리 화면을 몰래 겹쳐 띄우고 버튼을 누르게 하는 것(클릭재킹)을 막는다.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Content-Security-Policy "frame-ancestors 'none'"
		# 스크립트 출처 제한(#136) 1단계: 막지 않고 어기는 것을 브라우저 콘솔에 보고만 한다. 운영에서 화면·결제위젯·플레이어에
		# 위반이 없는 것을 확인한 뒤 위의 Content-Security-Policy로 옮긴다. 토스 결제위젯은 *.tosspayments.com에서,
		# 플레이어(OvenPlayer·hls.js)는 화면 코드와 함께 우리 주소에서 온다. hls.js는 blob: 주소로 작업 스레드를 띄운다.
		Content-Security-Policy-Report-Only "script-src 'self' https://*.tosspayments.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'"
		Referrer-Policy "strict-origin-when-cross-origin"
		# 카메라·마이크·화면 공유는 우리 화면에서만 쓸 수 있다(다른 사이트를 겹쳐 띄워 몰래 켜지 못하게). 위치 정보는 쓰지 않는다.
		Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=()"
		-Server
	}

	# OME 허락 웹훅은 OME와 백엔드끼리만 주고받는다. 인터넷에서는 막는다(#18, #5).
	# handle 블록은 서로 하나만 실행되고, 경로가 더 긴(구체적인) 쪽이 먼저 고려된다.
	# /api/ome(끝에 / 없음)도 막는다(#21 B1).
	handle /api/ome* {
		respond 404
	}

	# 백엔드 API: /api/health -> backend:8080/health
	handle_path /api/* {
		reverse_proxy backend:8080
	}

	# 송출(WHIP), WebRTC 신호(웹소켓), LL-HLS 시청 -> OME. 브라우저는 https/wss로 443에 붙는다.
	# OME 3333 포트는 인터넷에 열지 않는다.
	handle /app/* {
		reverse_proxy ome:3333
	}

	# 빌드된 JS·CSS(이름에 해시가 붙음): 없는 파일은 404로 끝낸다. 오래 캐시해도 된다(#21 C2).
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Caddy가 직접 만드는 오류 응답(없는 파일 404, OME 꺼짐 502 등)에도 보안 헤더를 붙이고 캐시하지 않게 한다(#21 2바퀴).
	handle_errors {
		header Cache-Control "no-store"
		header Strict-Transport-Security "max-age=31536000"
		header X-Content-Type-Options "nosniff"
		header Content-Security-Policy "frame-ancestors 'none'"
		header -Server
		respond "{err.status_code}"
	}

	# 화면(index.html): 매번 새 버전인지 확인하게 한다. 그래야 다시 배포한 뒤 옛 화면이 남지 않는다(#21 C2).
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
