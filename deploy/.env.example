# 배포 서버에서 deploy/.env로 복사해서 쓴다. deploy/.env는 git에 올라가지 않는다.
# 아래는 예시 값이다. 비밀값은 서버에서 임의로 만든다(예: openssl rand -hex 32).

# 서비스 주소(도메인). Caddy가 이 이름으로 HTTPS 인증서를 받는다.
DOMAIN=example.duckdns.org

# 서버의 공인 IP(고정 IP). 브라우저가 영상 통로로 붙을 주소다.
OME_HOST_IP=203.0.113.10

# DB 비밀번호. 로컬 예시 값(onair-local-only)을 쓰지 않는다.
# - 영문 소문자와 숫자(openssl rand -hex 24)만 쓴다. 이 값을 DATABASE_URL 주소에 그대로 넣기 때문에,
#   @ / # : % 같은 글자가 있으면 주소가 깨진다(#21 C4).
# - DB를 처음 만들 때(db-data 볼륨이 비어 있을 때)만 적용된다. 나중에 여기만 바꾸면 백엔드가 DB에 못 붙는다.
#   바꾸려면 DB 안에서도 ALTER USER onair PASSWORD '...'; 로 같이 바꾼다(#21 C3).
POSTGRES_PASSWORD=change-me

# OME 허락 웹훅 서명 키. 16자 이상, change-me로 시작하면 백엔드가 시작하지 않는다.
# 따옴표나 앞뒤 공백 없이 쓴다(openssl rand -hex 32).
OME_ADMISSION_SECRET=change-me

# 심사용 테스트 계정 로그인 버튼(demo1, demo2). 심사 기간에는 true로 둔다(#4, 공모 6절).
DEMO_LOGIN=true

# OME 관리 API 접근 토큰(#3). openssl rand -hex 32로 만든다.
OME_API_TOKEN=change-me
